local function setSwitchState(bg, circle, state)
	local targetPos = state and UDim2.new(1, -21, 0.5, -9) or UDim2.new(0, 3, 0.5, -9)
	local targetBgColor = state and Color3.fromRGB(0, 180, 0) or Color3.fromRGB(15, 15, 15)
	
	TweenService:Create(circle, TweenInfo.new(0.15), {Position = targetPos}):Play()
	TweenService:Create(bg, TweenInfo.new(0.15), {BackgroundColor3 = targetBgColor}):Play()
end

autoRedeemBtn.MouseButton1Click:Connect(function()
	config.autoRedeemActive = not config.autoRedeemActive
	setSwitchState(autoRedeemBtn, autoRedeemCircle, config.autoRedeemActive)
end)

delayBtn.MouseButton1Click:Connect(function()
	config.submitDelayActive = not config.submitDelayActive
	setSwitchState(delayBtn, delayCircle, config.submitDelayActive)
end)

wordBtn.MouseButton1Click:Connect(function()
	config.wordSubmitActive = not config.wordSubmitActive
	setSwitchState(wordBtn, wordCircle, config.wordSubmitActive)
end)

delayBox.FocusLost:Connect(function()
	local num = tonumber(delayBox.Text)
	if num then
		config.delayTime = math.max(0, num)
	else
		delayBox.Text = tostring(config.delayTime)
	end
end)

wordBox.FocusLost:Connect(function()
	local num = tonumber(wordBox.Text)
	if num and num > 0 then
		config.wordSubmitTarget = math.floor(num)
	else
		wordBox.Text = tostring(config.wordSubmitTarget)
	end
end)

keybindBtn.MouseButton1Click:Connect(function()
	config.listeningForKey = true
	keybindBtn.Text = "..."
end)

UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if config.listeningForKey then
		if input.UserInputType == Enum.UserInputType.Keyboard then
			config.toggleKey = input.KeyCode
			keybindBtn.Text = input.KeyCode.Name
			config.listeningForKey = false
		end
		return
	end

	if not gameProcessed and input.UserInputType == Enum.UserInputType.Keyboard then
		if input.KeyCode == config.toggleKey then
			config.autoRedeemActive = not config.autoRedeemActive
			setSwitchState(autoRedeemBtn, autoRedeemCircle, config.autoRedeemActive)
		end
	end
end)

modeBtn.MouseButton1Click:Connect(function()
