end)

--------------------------------------------------------------------------------
-- LÓGICA DEL CANJEADO (REDEEM & CHAT)
--------------------------------------------------------------------------------
local function sendTextToChat(text)
	if config.submitDelayActive and config.delayTime > 0 then
		task.wait(config.delayTime)
	end

	if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
		local generalChannel = TextChatService.TextChannels:FindFirstChild("RBXGeneral")
		if generalChannel then
			generalChannel:SendAsync(text)
		end
	else
		local chatEvents = game:GetService("ReplicatedStorage"):FindFirstChild("DefaultChatSystemChatEvents")
		if chatEvents then
			local sayMessage = chatEvents:FindFirstChild("SayMessageRequest")
			if sayMessage then
				sayMessage:FireServer(text, "All")
			end
		end
	end
end

local function processIncomingMessage(messageText)
	if not config.autoRedeemActive then return end

	local cleanText = string.gsub(messageText, "%s+", " ")
	cleanText = string.gsub(cleanText, "^%s*(.-)%s*$", "%1")
	if cleanText == "" then return end

	if config.wordSubmitActive then
		table.insert(config.collectedWords, cleanText)
		if #config.collectedWords >= config.wordSubmitTarget then
			local combinedMessage = table.concat(config.collectedWords, " ")
			config.collectedWords = {}

			if config.isAutoMode then
				sendTextToChat(combinedMessage)
			else
				pcall(function() setclipboard(combinedMessage) end)
			end
		end
	else
		if config.isAutoMode then
			sendTextToChat(cleanText)
		else
			pcall(function() setclipboard(cleanText) end)
		end
	end
end

testBox.FocusLost:Connect(function(enterPressed)
	if enterPressed and testBox.Text ~= "" then
		processIncomingMessage(testBox.Text)
		testBox.Text = ""
	end
end)

if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
	TextChatService.OnIncomingMessage = function(message)
		if message.TextSource and message.TextSource.UserId ~= player.UserId then
			processIncomingMessage(message.Text)
		end
	end
else
	playerGui:WaitForChild("Chat", 5)
	local chatEvents = game:GetService("ReplicatedStorage"):FindFirstChild("DefaultChatSystemChatEvents")
	if chatEvents then
		local onMessage = chatEvents:FindFirstChild("OnMessageDoneFiltering")
		if onMessage then
			onMessage.OnClientEvent:Connect(function(messageData)
				if messageData and messageData.FromSpeaker ~= player.Name then
					processIncomingMessage(messageData.Message)
				end
			end)
		end
	end
end
